<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Shared build for every service the factory creates. Services inherit this parent and keep only
    their coordinates and dependencies, so a build fix reaches all of them through a version bump.
    Released from claude-factory by pushing a tag factory-parent-vX.Y.Z (see .github/workflows).
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.github.nabiabdallah.factory</groupId>
  <artifactId>factory-parent</artifactId>
  <version>2.1.1</version>
  <packaging>pom</packaging>
  <name>factory-parent</name>
  <description>Shared Maven build for services created by the claude-factory java-pipeline</description>

  <properties>
    <java.version>21</java.version>
    <archunit.version>1.5.1</archunit.version>
    <spotless.version>3.10.4</spotless.version>
    <!-- Real Postgres for tests, no Docker (works inside the Claude Code sandbox): add-postgres skill. -->
    <embedded-postgres.version>2.2.2</embedded-postgres.version>
    <embedded-postgres-binaries.version>18.6.0</embedded-postgres-binaries.version>
    <!-- Container image (claude-factory ADR 0007): built by CI with ./mvnw jib:build, no Docker daemon. -->
    <jib.version>3.5.2</jib.version>
    <!-- Pinned to a digest (ADR 0009): the same build always gets the same base. The weekly factory workflow
         "base-image" opens a PR when distroless publishes a new digest (security fixes). -->
    <factory.image.base>gcr.io/distroless/java21-debian13:nonroot@sha256:d978eefd303c59c42f382aef811a0e41f2c68a6e5c319a23769cd3d1d5bf8e3c</factory.image.base>
    <factory.image.registry>ghcr.io/nabiabdallah</factory.image.registry>
    <!-- Build hygiene (claude-factory ADR 0013). Build-only plugins, nothing ships in the service. -->
    <extra-enforcer-rules.version>1.12.1</extra-enforcer-rules.version>
    <jacoco.version>0.8.15</jacoco.version>
    <!-- Not managed by Spring Boot; pinned so requirePluginVersions passes (Maven's default site binding). -->
    <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
    <!-- Coverage floor. A service may raise these in its POM; a lower value fails the Enforcer rule below. -->
    <factory.coverage.line.minimum>0.80</factory.coverage.line.minimum>
    <factory.coverage.branch.minimum>0.70</factory.coverage.branch.minimum>
    <!-- Defined empty so @{argLine} resolves when no other plugin (e.g. JaCoCo) sets it. -->
    <argLine></argLine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.zonky.test</groupId>
        <artifactId>embedded-postgres</artifactId>
        <version>${embedded-postgres.version}</version>
      </dependency>
      <dependency>
        <groupId>io.zonky.test.postgres</groupId>
        <artifactId>embedded-postgres-binaries-bom</artifactId>
        <version>${embedded-postgres-binaries.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <palantirJavaFormat/>
              <removeUnusedImports/>
              <importOrder/>
            </java>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Build hygiene (ADR 0013), checked at validate before anything compiles. A service that really needs a
           banned artifact excludes it from the rule in its own POM, with a comment saying why. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <dependencies>
          <!-- enforceBytecodeVersion: the only check that a library runs on the Java 21 image. -->
          <dependency>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>extra-enforcer-rules</artifactId>
            <version>${extra-enforcer-rules.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>factory-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <requirePluginVersions>
                  <message>Every plugin needs a fixed version (managed by Spring Boot or factory-parent, or set in the POM).</message>
                  <banLatest>true</banLatest>
                  <banRelease>true</banRelease>
                  <banSnapshots>true</banSnapshots>
                </requirePluginVersions>
                <requireReleaseDeps>
                  <message>No SNAPSHOT dependencies: a build must not change because someone republished a snapshot.</message>
                  <onlyWhenRelease>false</onlyWhenRelease>
                  <failWhenParentIsSnapshot>true</failWhenParentIsSnapshot>
                </requireReleaseDeps>
                <banDuplicatePomDependencyVersions/>
                <bannedDependencies>
                  <message>Banned dependency (factory ADR 0013): JUnit 4/vintage (JUnit 5 only); log4j 1 (end of life) and
log4j-core before 2.17.1 (Log4Shell); javax.* APIs (Spring Boot 4 is Jakarta EE 11, javax copies break silently);
commons-collections before 3.2.2 (deserialization RCE). Exclude it where it comes from, or, if it is really
needed, exclude it from this rule in the service POM with a comment.</message>
                  <excludes>
                    <exclude>junit:junit</exclude>
                    <exclude>org.junit.vintage</exclude>
                    <exclude>log4j:log4j</exclude>
                    <exclude>org.apache.logging.log4j:log4j-core:(,2.17.1)</exclude>
                    <exclude>javax.servlet</exclude>
                    <exclude>javax.persistence</exclude>
                    <exclude>javax.validation</exclude>
                    <exclude>javax.annotation:javax.annotation-api</exclude>
                    <exclude>javax.xml.bind</exclude>
                    <exclude>javax.ws.rs</exclude>
                    <exclude>commons-collections:commons-collections:(,3.2.2)</exclude>
                  </excludes>
                </bannedDependencies>
                <enforceBytecodeVersion>
                  <message>A dependency is compiled for a newer Java than the runtime image (Java 21).</message>
                  <maxJdkVersion>21</maxJdkVersion>
                  <ignoredScopes>
                    <ignoredScope>test</ignoredScope>
                    <ignoredScope>provided</ignoredScope>
                  </ignoredScopes>
                </enforceBytecodeVersion>
                <!-- Raise-only coverage floor: values below 0.80 lines / 0.70 branches are rejected. -->
                <requireProperty>
                  <property>factory.coverage.line.minimum</property>
                  <regex>0\.[89][0-9]*|1(\.0+)?</regex>
                  <regexMessage>factory.coverage.line.minimum may be raised, not set below 0.80 (factory ADR 0013). Add tests instead.</regexMessage>
                </requireProperty>
                <requireProperty>
                  <property>factory.coverage.branch.minimum</property>
                  <regex>0\.[7-9][0-9]*|1(\.0+)?</regex>
                  <regexMessage>factory.coverage.branch.minimum may be raised, not set below 0.70 (factory ADR 0013). Add tests instead.</regexMessage>
                </requireProperty>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Coverage floor (ADR 0013): the JaCoCo agent runs with the tests (it fills @{argLine}); verify fails below
           the floor. Report: target/site/jacoco/index.html. The Spring Boot main class (only main) is excluded. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <excludes>
            <exclude>**/*Application.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>coverage-floor</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${factory.coverage.line.minimum}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${factory.coverage.branch.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Container image: distroless (no shell, non-root uid 65532), reproducible layers, OCI format.
           CI passes tags and credentials: -Djib.to.tags=<sha>,main -Djib.to.auth.username/password. -->
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <version>${jib.version}</version>
        <configuration>
          <from>
            <image>${factory.image.base}</image>
          </from>
          <to>
            <image>${factory.image.registry}/${project.artifactId}</image>
          </to>
          <container>
            <format>OCI</format>
            <user>65532:65532</user>
            <ports>
              <port>8080</port>
            </ports>
            <jvmFlags>
              <jvmFlag>-XX:MaxRAMPercentage=75</jvmFlag>
              <jvmFlag>-XX:+ExitOnOutOfMemoryError</jvmFlag>
            </jvmFlags>
            <labels>
              <org.opencontainers.image.source>https://github.com/nabiabdallah/${project.artifactId}</org.opencontainers.image.source>
            </labels>
          </container>
        </configuration>
      </plugin>

      <!-- SBOM (ADR 0009): Spring Boot manages this plugin's version and execution but only runs it when it is
           listed here. Writes the runtime dependencies to META-INF/sbom/application.cdx.json (in the jar). -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
      </plugin>

      <!-- Load Mockito as a Java agent instead of letting it self-attach at runtime:
           Mockito's documented setup for JDK 21+, and required inside the Claude Code sandbox,
           where the JVM attach mechanism can't use /tmp. Sets ${org.mockito:mockito-core:jar}. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Formatting gate: `spotless:check` runs in verify, the PostToolUse hook runs `spotless:apply`. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>claude-factory packages</name>
      <url>https://maven.pkg.github.com/nabiabdallah/claude-factory</url>
    </repository>
  </distributionManagement>
</project>
