<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Shared build for every service the factory creates. Services inherit this parent and keep only
    their coordinates and dependencies, so a build fix reaches all of them through a version bump.
    Released from claude-factory by pushing a tag factory-parent-vX.Y.Z (see .github/workflows).
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.github.nabiabdallah.factory</groupId>
  <artifactId>factory-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>factory-parent</name>
  <description>Shared Maven build for services created by the claude-factory java-pipeline</description>

  <properties>
    <java.version>21</java.version>
    <archunit.version>1.5.1</archunit.version>
    <spotless.version>3.10.4</spotless.version>
    <!-- Defined empty so @{argLine} resolves when no other plugin (e.g. JaCoCo) sets it. -->
    <argLine></argLine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <palantirJavaFormat/>
              <removeUnusedImports/>
              <importOrder/>
            </java>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Load Mockito as a Java agent instead of letting it self-attach at runtime:
           Mockito's documented setup for JDK 21+, and required inside the Claude Code sandbox,
           where the JVM attach mechanism can't use /tmp. Sets ${org.mockito:mockito-core:jar}. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Formatting gate: `spotless:check` runs in verify, the PostToolUse hook runs `spotless:apply`. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>claude-factory packages</name>
      <url>https://maven.pkg.github.com/nabiabdallah/claude-factory</url>
    </repository>
  </distributionManagement>
</project>
