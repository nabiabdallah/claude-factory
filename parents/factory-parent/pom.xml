<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Shared build for every service the factory creates. Services inherit this parent and keep only
    their coordinates and dependencies, so a build fix reaches all of them through a version bump.
    Released from claude-factory by pushing a tag factory-parent-vX.Y.Z (see .github/workflows).
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.github.nabiabdallah.factory</groupId>
  <artifactId>factory-parent</artifactId>
  <version>2.0.0</version>
  <packaging>pom</packaging>
  <name>factory-parent</name>
  <description>Shared Maven build for services created by the claude-factory java-pipeline</description>

  <properties>
    <java.version>21</java.version>
    <archunit.version>1.5.1</archunit.version>
    <spotless.version>3.10.4</spotless.version>
    <!-- Real Postgres for tests, no Docker (works inside the Claude Code sandbox): add-postgres skill. -->
    <embedded-postgres.version>2.2.2</embedded-postgres.version>
    <embedded-postgres-binaries.version>18.6.0</embedded-postgres-binaries.version>
    <!-- Container image (claude-factory ADR 0007): built by CI with ./mvnw jib:build, no Docker daemon. -->
    <jib.version>3.5.2</jib.version>
    <!-- Pinned to a digest (ADR 0009): the same build always gets the same base. The weekly factory workflow
         "base-image" opens a PR when distroless publishes a new digest (security fixes). -->
    <factory.image.base>gcr.io/distroless/java21-debian13:nonroot@sha256:b22857e939bd95abd69d9d747f0421a274f9f70855ecfc335f7d97f6eeef578d</factory.image.base>
    <factory.image.registry>ghcr.io/nabiabdallah</factory.image.registry>
    <!-- Defined empty so @{argLine} resolves when no other plugin (e.g. JaCoCo) sets it. -->
    <argLine></argLine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.zonky.test</groupId>
        <artifactId>embedded-postgres</artifactId>
        <version>${embedded-postgres.version}</version>
      </dependency>
      <dependency>
        <groupId>io.zonky.test.postgres</groupId>
        <artifactId>embedded-postgres-binaries-bom</artifactId>
        <version>${embedded-postgres-binaries.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <palantirJavaFormat/>
              <removeUnusedImports/>
              <importOrder/>
            </java>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Container image: distroless (no shell, non-root uid 65532), reproducible layers, OCI format.
           CI passes tags and credentials: -Djib.to.tags=<sha>,main -Djib.to.auth.username/password. -->
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <version>${jib.version}</version>
        <configuration>
          <from>
            <image>${factory.image.base}</image>
          </from>
          <to>
            <image>${factory.image.registry}/${project.artifactId}</image>
          </to>
          <container>
            <format>OCI</format>
            <user>65532:65532</user>
            <ports>
              <port>8080</port>
            </ports>
            <jvmFlags>
              <jvmFlag>-XX:MaxRAMPercentage=75</jvmFlag>
              <jvmFlag>-XX:+ExitOnOutOfMemoryError</jvmFlag>
            </jvmFlags>
            <labels>
              <org.opencontainers.image.source>https://github.com/nabiabdallah/${project.artifactId}</org.opencontainers.image.source>
            </labels>
          </container>
        </configuration>
      </plugin>

      <!-- SBOM (ADR 0009): Spring Boot manages this plugin's version and execution but only runs it when it is
           listed here. Writes the runtime dependencies to META-INF/sbom/application.cdx.json (in the jar). -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
      </plugin>

      <!-- Load Mockito as a Java agent instead of letting it self-attach at runtime:
           Mockito's documented setup for JDK 21+, and required inside the Claude Code sandbox,
           where the JVM attach mechanism can't use /tmp. Sets ${org.mockito:mockito-core:jar}. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Formatting gate: `spotless:check` runs in verify, the PostToolUse hook runs `spotless:apply`. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>claude-factory packages</name>
      <url>https://maven.pkg.github.com/nabiabdallah/claude-factory</url>
    </repository>
  </distributionManagement>
</project>
